# Derived from the code, by reading every import in `src/zotero_core`. There are no
# third-party imports to check: the sqlite adapters are stdlib `sqlite3`, both write
# transports are stdlib `urllib`, and `mcp` appears only inside the adapters.
#
# THE LAYER NAMES ARE omni-rag's, DELIBERATELY
# --------------------------------------------
# This file used to name `interfaces > write > read > domain`, which described the
# merge rather than an architecture: `read` was a layer named after a DIRECTION, and
# it held the sqlite driver, the HTTP clients and a facade all at one level. The names
# now match the convention `omni-rag` already enforces, so this package reads like the
# rest of the estate:
#
#     read/{connect,items,collections,search,annotations,duplicates,libraries}
#                                          -> infrastructure/sqlite/     (the driver)
#     read/{bridge,bbt}                    -> infrastructure/http/       (the network)
#     write/transports/{cookjohn,linker}   -> infrastructure/transports/ (the network)
#     write/journal.py                     -> infrastructure/journal.py  (the filesystem)
#     write/errors.py                      -> domain/errors.py           (pure vocabulary)
#
#     write/{verbs,collections,liveness,replay} -> application/services/
#
# ✅ THE INVERSION IS DONE. This comment used to say `write` "is NOT yet `application`" and
# that the order "still puts it ABOVE infrastructure" — which contradicted the contract 21
# lines below, where the layers already read
# `interfaces > infrastructure > application > domain`. It became true when the verbs
# stopped naming adapters: `application/` now depends on `domain/ports/` only, and
# `interfaces/factory.py` injects the concrete ones. Verified independently by dumping every
# import in `application/` and `domain/` — stdlib plus `zotero_core.{domain,application}.*`,
# nothing else.
[importlinter]
root_packages =
    zotero_core
# Required because the forbidden contracts below name modules outside the root package
# (`sqlite3`, `urllib`, `mcp`); without it import-linter errors instead of checking.
include_external_packages = True

# --------------------------------------------------------------------------
# 1. the direction that used to be a package boundary
# --------------------------------------------------------------------------
# Formerly the `suite-direction` contract over two root packages, then
# `interfaces > write > read > domain`. It is the same rule throughout: direction.
# Infrastructure must never import the write path -- every precondition a write needs
# is a read (does the key resolve, is it already trashed, what tags are there to be
# replaced), so writes depend on reads and reads never depend on writes. That
# acyclicity is why one package is safe.
#
# `zotero_core/__init__.py` is deliberately NOT a layer: it is the published API and
# imports across every layer by design.
[importlinter:contract:layers]
name = interfaces above infrastructure above application above domain
type = layers
layers =
    zotero_core.interfaces
    zotero_core.infrastructure
    zotero_core.application
    zotero_core.domain

# --------------------------------------------------------------------------
# 2. the write spine
# --------------------------------------------------------------------------
# Read off the imports rather than designed. Bottom to top:
#
#   results            the success-envelope builder. It imports NOTHING from the
#                      package, which is what lets the failure path, the audit path
#                      and the success path sit side by side rather than one
#                      depending on another.
#   liveness           imports both transports and the error vocabulary. It is the
#                      only module that knows about both transports, because
#                      distinguishing "Zotero is down" from "one plugin is missing"
#                      needs both probes.
#   verbs, collections NON-INDEPENDENT siblings (`:` not `|`): they import each other
#                      through deferred function-level imports -- `verbs.create_item`
#                      calls `collections.add_items_to_collection` to file a new item,
#                      and both collection-membership verbs call
#                      `verbs.check_keys`/`require_items`. That cycle is real and
#                      declaring it is more honest than splitting the layer to hide it.
#   replay             reads the journal and replays an inverse, so it sits ABOVE the
#                      verbs it calls. Its imports of `verbs`/`collections` are deferred
#                      into a function, which is what keeps the whitelist from making
#                      this module a hard dependency of every verb.
#
# ⚠ Three modules LEFT this spine and the contract shrank accordingly: `transports`
# and `journal` are infrastructure, `errors` is domain. Contract 1 now places all
# three below everything here, which is strictly stronger than their old rung.
[importlinter:contract:write-spine]
name = application layers: replay above verbs above liveness above results
type = layers
layers =
    zotero_core.application.services.replay | zotero_core.application.services.papers
    zotero_core.application.services.verbs : zotero_core.application.services.collections
    zotero_core.application.services.liveness
    zotero_core.application.results

# --------------------------------------------------------------------------
# 3. no SQL in the write path
# --------------------------------------------------------------------------
# "Never open zotero.sqlite read-write". Every read a gate needs comes from
# `zotero_core.infrastructure.sqlite`, which opens the database read-only with an
# `immutable=1` fallback. A local `sqlite3.connect()` here would be a second, ungated
# path to the same file, in the layer whose entire purpose is that there is one path.
#
# `allow_indirect_imports = True` is REQUIRED and is not a loosening -- without it the
# contract fails on `write.collections -> infrastructure.sqlite.items -> sqlite3`,
# which is the sanctioned path this rule exists to funnel reads INTO. The rule is "no
# `import sqlite3` in this layer", not "never reach a module that opens the database";
# the latter would forbid reading anything at all.
[importlinter:contract:no-sql-in-the-write-path]
name = write reaches the database only through the sqlite adapters
type = forbidden
source_modules =
    zotero_core.application
forbidden_modules =
    sqlite3
allow_indirect_imports = True

# --------------------------------------------------------------------------
# 4. `mcp` belongs to the adapters alone
# --------------------------------------------------------------------------
# `dependencies = []` is the real constraint: this package installs no third party, so
# an `mcp` import outside `interfaces` would force every consumer to install an async
# runtime just to import a tag verb. `omni-rag` imports the read path inside its ARC
# entrypoints, where that cost is not hypothetical.
#
# ⚠ THIS COMMENT USED TO JUSTIFY THE RULE BY VENDORING -- "`calibre-zotero-jump/ui.py`
# runs inside Calibre's embedded Python... an `mcp` import anywhere in the write path
# would make it unvendorable". That premise is FALSE and was checked on 2026-08-19:
# `calibre-zotero-jump/build.sh` zips exactly `__init__.py`, `ui.py` and the
# import-name marker, and `ui.py` contains the string "cookjohn" zero times. It is an
# INDEPENDENT REIMPLEMENTATION -- its own `_rpc`, its own `\b([A-Z0-9]{8})\b` -- not a
# vendored copy of `transports/cookjohn.py`. The rule survives on `dependencies = []`;
# the vendoring argument does not, and anything else resting on it (a Protocol chosen
# so cookjohn "stays import-standalone") needs a different reason or none.
#
# `interfaces` is excluded because it is the layer allowed to import `mcp`, and it does
# so INSIDE `main()`; AST tests assert that from the other direction.
[importlinter:contract:mcp-only-in-the-adapter]
name = only interfaces may import mcp, so the rest stays stdlib-only
type = forbidden
source_modules =
    zotero_core.application
    zotero_core.infrastructure
    zotero_core.domain
forbidden_modules =
    mcp

# --------------------------------------------------------------------------
# 5. the domain is pure
# --------------------------------------------------------------------------
# `domain` holds the rules that were duplicated because there was nowhere to put them:
# the key regex (five copies, four implementations), the annotation-type table (three
# copies, two disagreeing fallbacks), the read-mode literal (~45 bare strings), and now
# the error vocabulary. A layer that cannot import a driver is what stops them drifting
# apart again -- entities and policy must be checkable without a database, a network,
# or an async runtime.
[importlinter:contract:domain-is-pure]
name = domain imports no driver -- no sqlite, no network, no mcp
type = forbidden
source_modules =
    zotero_core.domain
forbidden_modules =
    sqlite3
    urllib
    mcp
